{
  "schemaVersion": 1,
  "baseline": {
    "id": "cloga.dsh-github-copilot",
    "kind": "standalone-dsh-plugin",
    "source": "https://github.com/cloga/dsh-github-copilot",
    "sourceCommitPolicy": "exact-external-pin"
  },
  "package": {
    "name": "dsh-github-copilot",
    "version": "0.3.0-cloga.7"
  },
  "supportedBaselines": {
    "platforms": ["windows", "linux"],
    "node": ">=22.0.0",
    "dsh": {
      "release": "0.1.2-alpha.4",
      "developmentRelease": "0.1.1-rc.2",
      "peerRange": "^0.1.1-rc.2 || ^0.1.2-alpha.4"
    },
    "piAi": "^0.84.2",
    "runtimeDependencies": {
      "@deepseek-ai/dsh-authorization": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
      "zod": "^4.4.3"
    }
  },
  "capabilities": [
    { "id": "client-module-loader-handoff", "required": true },
    { "id": "strict-remote-result-codecs", "required": true },
    { "id": "authorization-service-bootstrap", "required": true },
    { "id": "models-provider-card-authorization", "required": true },
    { "id": "reference-free-route-mutation", "required": true },
    { "id": "per-model-api-route-materialization", "required": true },
    { "id": "shared-copilot-credential-refresh", "required": true },
    { "id": "strict-json-oauth-grant-normalization", "required": true },
    { "id": "direct-provider-hosted-search", "required": true },
    { "id": "traditional-search-bridge", "required": true },
    { "id": "dsh-supported-baselines-fail-loud-guard", "required": true },
    { "id": "dsh-rc2-models-settings-fallback", "required": true }
  ]
}
