{
  "schemaVersion": 1,
  "dshHome": "%USERPROFILE%\\.dsh",
  "components": [
    {
      "name": "dsh-desktop",
      "rootEnv": "DSH_DESKTOP_ROOT",
      "rootCandidates": [
        "%LOCALAPPDATA%\\Deepseek Harness Desktop"
      ],
      "executables": [
        "deepseek-harness-desktop.exe"
      ],
      "versionProbes": [],
      "fileVersionProbes": [
        {
          "path": "deepseek-harness-desktop.exe"
        }
      ]
    },
    {
      "name": "dsh-desktop-runtime",
      "rootEnv": "DSH_DESKTOP_RUNTIME_ROOT",
      "rootCandidates": [
        "%APPDATA%\\io.github.hairyf.deepseek-harness-desktop\\dependencies\\dsh"
      ],
      "versionProbes": [
        {
          "path": "node_modules\\@deepseek-ai\\dsh\\package.json",
          "property": "version"
        }
      ]
    },
    {
      "name": "dsh-github-copilot",
      "rootEnv": "DSH_GITHUB_COPILOT_ROOT",
      "rootCandidates": [
        "${DSH_HOME}\\profiles\\web\\node_modules\\dsh-github-copilot"
      ],
      "versionProbes": [
        {
          "path": "package.json",
          "property": "version"
        }
      ]
    },
    {
      "name": "pi-ai",
      "rootEnv": "PI_AI_ROOT",
      "rootCandidates": [
        "${DSH_HOME}\\profiles\\web\\node_modules\\@earendil-works\\pi-ai",
        "${DSH_HOME}\\profiles\\web\\node_modules\\@mariozechner\\pi-ai"
      ],
      "versionProbes": [
        {
          "path": "package.json",
          "property": "version"
        }
      ]
    }
  ],
  "services": [
    {
      "name": "dsh-desktop",
      "processPattern": "DeepSeek Harness|bin\\.js.*\\bweb\\b",
      "ports": []
    }
  ],
  "configFiles": [
    "${DSH_HOME}\\settings.yaml",
    "${DSH_HOME}\\profiles\\web\\cordis.patch.yml",
    "${DSH_HOME}\\profiles\\headless\\cordis.patch.yml"
  ],
  "modelEndpoints": []
}
