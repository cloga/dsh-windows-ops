function ConvertTo-CanonicalJson { param($Value) return ($Value | ConvertTo-Json -Depth 40 -Compress) }
function Get-DshOfficialDesktopBuildPolicy { [CmdletBinding()]param() return ($script:PolicyJson | ConvertFrom-Json) }
function Test-DshOfficialDesktopBuildPolicy { [CmdletBinding()]param([Parameter(Mandatory)]$Policy); if ((ConvertTo-CanonicalJson $Policy) -cne (ConvertTo-CanonicalJson (Get-DshOfficialDesktopBuildPolicy))) { throw 'official-desktop-policy-invalid' }; $true }
