        "supported_endpoints"
      ]
    },
    "composedConfig": {
      "command": [
        "dsh",
        "--profile",
        "web",
        "--dump-config"
      ],
      "requiredMarkers": [
        "dsh-github-copilot",
        "searchProvider: github-copilot-hosted"
      ],
      "requiredEntries": [
        {
          "id": "web",
          "name": "@deepseek-ai/dsh-web"
        },
        {
          "id": "tool-web",
          "name": "@deepseek-ai/dsh-tool-web"
        },
        {
          "id": "github-copilot",
          "name": "dsh-github-copilot"
        }
      ],
      "forbiddenMarkers": [
        "searchProvider: copilot-hosted",
        "searchProvider: deepseek-official"
      ],
      "forbiddenActiveEntries": [
        "web-search-provider"
      ],
      "managedEntry": {
        "id": "github-copilot",
        "enabled": true,
        "provider": "github-copilot",
        "protocol": "openai-responses",
        "hostEntry": "web",
        "settingsNamespace": "github-copilot",
        "searchProvider": "github-copilot-hosted"
      }
    },
    "loaderImports": [
      "@deepseek-ai/cordis-plugin-hmr",
      "@deepseek-ai/cordis-plugin-timer",
      "node-addon-require-builtin"
    ],
    "searchSmoke": {
      "method": "POST",
      "url": "http://127.0.0.1:7777/v1/responses",
      "requiredToolType": "web_search",
      "requiredEvidenceProperties": [
        "sources",
        "url_citation"
      ],
      "forbiddenText": [
        "DEEPSEEK_API_KEY",
        "provider-not-registered"
      ],
      "manualWhenModelIsUnset": true
    },
    "traditionalSearch": {
      "provider": "github-copilot-hosted",
      "requiredEvidenceProperty": "sources",
      "forbiddenText": [
        "DEEPSEEK_API_KEY",
        "provider-not-registered"
      ]
    },
    "reasoning": {
      "responses": "nonempty-only",
      "anthropic": "nonempty-only"
    },
    "sandbox": {
      "gate": "Require",
      "sameAndNarrower": "no-op",
      "widerApprovalCount": 1
    }
  },
  "backup": {
