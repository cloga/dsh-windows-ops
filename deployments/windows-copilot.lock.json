      },
      {
        "name": "copilot2api",
        "host": "127.0.0.1",
        "port": 7777
      }
    ],
    "modelCatalog": {
      "url": "http://127.0.0.1:7777/v1/models",
      "minimumModels": 1,
      "requiredFields": [
