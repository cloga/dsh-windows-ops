function Get-LocalPackageEvidence { param([string]$Source,[string]$Root,$Policy,[string]$OverlayPath);$target=Join-Path $Source ($script:ArtifactRelativeRoot.Replace('/','\'));Assert-NoReparseTree $target;$artifacts=Join-Path $target 'artifacts';$installer=Join-Path $artifacts $Policy.localPackage.installerName;$unpacked=Join-Path $artifacts 'win-unpacked';$exe=Join-Path $unpacked ($Policy.localPackage.productName+'.exe');$asar=Join-Path $unpacked 'resources\app.asar';$release=Join-Path $target 'seed\desktop-release.json';$runtime=Join-Path $target 'runtime\versions.json';foreach($p in @($installer,$exe,$asar,$release,$runtime,$OverlayPath)){if(-not(Test-Path -LiteralPath $p -PathType Leaf)){throw('local-package-artifact-missing:'+($p|Split-Path -Leaf))}};$expectedOverlay=Get-NormalizedPath (Join-Path (Join-Path $Root $Policy.toolStateDirectory) 'local-electron-builder.config.mjs');if((Get-NormalizedPath $OverlayPath)-cne$expectedOverlay-or-not(Test-PathAtOrWithin $expectedOverlay (Join-Path $Root $Policy.toolStateDirectory))){throw 'local-overlay-path-mismatch'};Assert-NoReparseTree (Split-Path -Parent $expectedOverlay);if([IO.File]::ReadAllText($expectedOverlay)-cne(Get-LocalOverlayContent $Source $Policy)){throw 'local-overlay-content-mismatch'};$rel=Get-Content $release -Raw|ConvertFrom-Json;$run=Get-Content $runtime -Raw|ConvertFrom-Json;if($rel.version-cne$Policy.version-or$rel.hostProtocolVersion-ne3-or$rel.nodeVersion-cne'24.17.0'-or$rel.pnpmVersion-cne'11.7.0'-or$run.node-cne'24.17.0'-or$run.pnpm-cne'11.7.0'){throw 'local-package-seed-version-mismatch'};if(Test-Path (Join-Path $unpacked 'resources\app-update.yml')){throw 'local-package-update-config-present'};$installerSig=(Get-AuthenticodeSignature $installer).Status.ToString();$exeSig=(Get-AuthenticodeSignature $exe).Status.ToString();if($installerSig-cne'NotSigned'-or$exeSig-cne'NotSigned'){throw 'local-package-unexpected-signature'};$versionInfo=Get-LocalExecutableVersionInfo $exe;foreach($value in @($versionInfo.ProductName,$versionInfo.FileDescription,$versionInfo.InternalName)){if($value-cne$Policy.localPackage.productName){throw 'local-package-version-info-identity-mismatch'}};[pscustomobject]@{overlayPath=(Get-NormalizedPath $OverlayPath);installerPath=(Get-NormalizedPath $installer);installerSignature=$installerSig;executablePath=(Get-NormalizedPath $exe);executableSignature=$exeSig;appUpdatePresent=$false;identity=[pscustomobject]@{appId=$Policy.localPackage.appId;packageName=$Policy.localPackage.packageName;productName=$Policy.localPackage.productName};seed=$rel;hashes=[pscustomobject]@{installer=(Get-FileHash $installer -Algorithm SHA256).Hash.ToLowerInvariant();appAsar=(Get-FileHash $asar -Algorithm SHA256).Hash.ToLowerInvariant();executable=(Get-FileHash $exe -Algorithm SHA256).Hash.ToLowerInvariant();seed=(Get-TreeHash (Join-Path $target 'seed'));overlay=(Get-FileHash $OverlayPath -Algorithm SHA256).Hash.ToLowerInvariant()}} }
function Test-DshOfficialDesktopBuildReceipt {
 [CmdletBinding()]param([Parameter(Mandatory)][string]$Path,[Parameter(Mandatory)][string]$SourceRoot,$Policy=(Get-DshOfficialDesktopBuildPolicy),[string]$GitPath=(Get-OfficialToolPath git),[string]$NodeVersion,[string]$PnpmVersion='11.7.0',[scriptblock]$CommandRunner)
 try {
  $r=Get-Content $Path -Raw|ConvertFrom-Json
  $topKeys=@('schemaVersion','action','status','createdUtc','source','tools','commands','artifacts','validation','releaseBoundary','receiptSha256')
  if($r.action-ceq'build'){$topKeys+='registryRouting'}
  if($r.action-ceq'packagelocal'){$topKeys+=@('registryRouting','localPackage')}
  if(-not(Test-ExactKeys $r $topKeys)){throw 'schema-keys'}
  if((Get-ReceiptPayloadHash $r)-cne$r.receiptSha256){throw 'self-hash'}
  if($r.schemaVersion-ne1-or$r.action-cnotin@('prepare','build','packagelocal')-or$r.status-cne'complete'){throw 'schema-values'}
  if(-not(Test-ExactKeys $r.source @('repository','tag','commit','tree','clean','lockfileSha256'))-or-not(Test-ExactKeys $r.tools @('nodeVersion','packageManager','pnpmVersion'))-or-not(Test-ExactKeys $r.validation @('launchedGui','installedDesktop','trackedSourceModified','isolatedDshHome'))){throw 'nested-schema-keys'}
  $root=Split-Path -Parent (Get-NormalizedPath $SourceRoot)
  Assert-ManagedBuildTrees $root $Policy -IncludeTarget
  if((Get-NormalizedPath $r.validation.isolatedDshHome)-cne(Get-NormalizedPath (Join-Path $root 'isolated-dsh-home'))){throw 'isolated-home-path'}
  $state=Assert-OfficialSourceState $SourceRoot $GitPath $Policy $null $CommandRunner
  if($r.source.repository-cne$Policy.repository-or$r.source.tag-cne$Policy.tag-or$r.source.commit-cne$Policy.commit-or$r.source.tree-cne$Policy.tree-or$r.source.clean-ne$true-or$r.source.lockfileSha256-cne$state.lockHash){throw 'source-fields'}
  if($r.tools.packageManager-cne$Policy.packageManager-or$r.tools.pnpmVersion-cne$PnpmVersion-or($NodeVersion-and$r.tools.nodeVersion-cne$NodeVersion)){throw 'tool-fields'}
  $expected=if($r.action-ceq'prepare'){@('pnpm-version','frozen-install')}elseif($r.action-ceq'build'){@('pnpm-version','frozen-install','official-desktop-test','official-desktop-prepare')}else{@('pnpm-version','frozen-install','official-desktop-test','official-desktop-prepare','local-electron-builder')}
  $actualNames=@($r.commands|ForEach-Object{$_.name});if((ConvertTo-CanonicalJson $actualNames)-cne(ConvertTo-CanonicalJson $expected)){throw ('command-order:'+($actualNames-join','))}
  $corepack=Get-OfficialToolPath corepack
  foreach($c in @($r.commands)){
   if(-not(Test-ExactKeys $c @('name','executable','workingDirectory','arguments','startedUtc','durationMilliseconds','exitCode'))-or$c.exitCode-ne0-or-not[IO.Path]::IsPathRooted($c.executable)){throw 'command-shape'}
   if((Get-NormalizedPath $c.executable)-cne(Get-NormalizedPath $corepack)){throw 'command-executable'}
   $expectedWorkingDirectory=if($c.name-ceq'local-electron-builder'){Get-NormalizedPath (Join-Path $SourceRoot 'apps\desktop')}else{Get-NormalizedPath $SourceRoot}
   if((Get-NormalizedPath $c.workingDirectory)-cne$expectedWorkingDirectory){throw 'command-working-directory'}
   $expectedArgs=switch($c.name){'pnpm-version'{@(('pnpm@'+$PnpmVersion),'--version')}'frozen-install'{@(('pnpm@'+$PnpmVersion))+@($Policy.officialCommands.install)}'official-desktop-test'{@(('pnpm@'+$PnpmVersion))+@($Policy.officialCommands.tests[0].args)}'official-desktop-prepare'{@(('pnpm@'+$PnpmVersion))+@($Policy.officialCommands.build)}'local-electron-builder'{@(('pnpm@'+$PnpmVersion),'exec','electron-builder','--config',$r.localPackage.overlayPath,'--win','--x64','--publish','never')}}
   if((ConvertTo-CanonicalJson @($c.arguments))-cne(ConvertTo-CanonicalJson $expectedArgs)){throw 'command-order'}
  }
  if($r.validation.launchedGui-ne$false-or$r.validation.installedDesktop-ne$false-or$r.validation.trackedSourceModified-ne$false){throw 'command-order'}
  foreach($a in @($r.artifacts)){if(-not(Test-ExactKeys $a @('path','size','sha256'))-or$a.path.StartsWith('/')-or$a.path.Contains('..')-or-not$a.path.StartsWith($script:ArtifactRelativeRoot+'/',[StringComparison]::Ordinal)){throw 'command-order'}}
  if((ConvertTo-CanonicalJson @($r.artifacts))-cne(ConvertTo-CanonicalJson @(Get-OfficialArtifactInventory $SourceRoot))){throw 'command-order'}
  if($r.action-cin@('build','packagelocal')){if(-not(Test-ExactKeys $r.registryRouting @('registry','deviation','sourcePath','originalSha256','literalCount','patchedSha256','restored','lockAndIntegrityRetained'))-or$r.registryRouting.restored-ne$true-or$r.registryRouting.literalCount-ne2-or$r.registryRouting.originalSha256-cne$Policy.prepareSeedSha256-or$r.registryRouting.lockAndIntegrityRetained-ne$true){throw 'command-order'};Assert-DshRegistry $r.registryRouting.registry|Out-Null;if(($r.registryRouting.registry-cne$Policy.defaultRegistry)-ne[bool]$r.registryRouting.deviation){throw 'command-order'}}
  if($r.action-ceq'packagelocal'){if((ConvertTo-CanonicalJson $r.releaseBoundary)-cne(ConvertTo-CanonicalJson $Policy.localReleaseBoundary)){throw 'command-order'};$e=Get-LocalPackageEvidence $SourceRoot $root $Policy $r.localPackage.overlayPath;if((ConvertTo-CanonicalJson $e)-cne(ConvertTo-CanonicalJson $r.localPackage)){throw 'command-order'}}elseif((ConvertTo-CanonicalJson $r.releaseBoundary)-cne(ConvertTo-CanonicalJson $Policy.releaseBoundary)){throw 'command-order'}
  $true
 } catch {$script:LastReceiptValidationError=$_.Exception.Message;Write-Verbose("receipt-invalid: "+$_.Exception.Message);$false}
}
function Get-DshOfficialDesktopBuildCheck { [CmdletBinding()]param([string]$BuildRoot='C:\tmp\dsh-official-desktop-build\work',[scriptblock]$CommandRunner,$Policy=(Get-DshOfficialDesktopBuildPolicy),[string]$Registry='https://registry.npmjs.org/');Test-DshOfficialDesktopBuildPolicy $Policy|Out-Null;$registryValue=Assert-DshRegistry $Registry;$root=Assert-DshOfficialDesktopBuildRoot $BuildRoot;$git=Get-OfficialToolPath git;$node=Get-OfficialToolPath node;$corepack=Get-OfficialToolPath corepack;$reasons=[Collections.Generic.List[string]]::new();if(-not$git){$reasons.Add('git-unavailable')};if(-not$node){$reasons.Add('node-unavailable')};if(-not$corepack){$reasons.Add('corepack-unavailable')};$cwd=Split-Path $PSScriptRoot -Parent;$gitEnv=@{GIT_CONFIG_NOSYSTEM='1';GIT_CONFIG_GLOBAL='NUL'};$nodeVersion=$null;if($node){$nodeVersion=(Invoke-OfficialCheckedCommand node-version $node @('--version') $cwd $null $CommandRunner).output[-1].Trim();if(-not(Test-OfficialNodeVersion $nodeVersion)){$reasons.Add('node-engine-mismatch')}};$remoteCommit=$null;if($git){$o=Invoke-OfficialGit official-tag $git @('ls-remote','--refs',$Policy.repository,('refs/tags/'+$Policy.tag)) $cwd $gitEnv $CommandRunner;$line=@($o.output|Where-Object{$_-match'^[0-9a-f]{40}\s+'});if($line.Count-ne1){$reasons.Add('official-tag-unresolved')}else{$remoteCommit=($line[0]-split'\s+')[0];if($remoteCommit-cne$Policy.commit){$reasons.Add('official-tag-commit-mismatch')}}};$community=Join-Path $env:APPDATA 'io.github.hairyf.deepseek-harness-desktop';[pscustomobject]@{schemaVersion=1;action='check';status=$(if($reasons.Count){'blocked'}else{'ready'});reasons=@($reasons);buildRoot=$root;registry=$registryValue;policy=[pscustomobject]@{repository=$Policy.repository;tag=$Policy.tag;commit=$Policy.commit;tree=$Policy.tree};tools=[pscustomobject]@{git=$git;node=$node;corepack=$corepack;nodeVersion=$nodeVersion;requiredPnpm=$Policy.packageManager};officialRef=[pscustomobject]@{resolvedCommit=$remoteCommit;verified=$remoteCommit-ceq$Policy.commit};currentFacts=[pscustomobject]@{communityDesktopDataPresent=[bool](Test-Path $community);liveDataReadOnly=$true;liveProcessesInspected=$false;liveDataModified=$false};releaseBoundary=$Policy.releaseBoundary} }
function Invoke-DshOfficialDesktopBuild {
 [CmdletBinding()]param([ValidateSet('Check','Prepare','Verify','Build','PackageLocal')][string]$Action='Check',[string]$BuildRoot='C:\tmp\dsh-official-desktop-build\work',[scriptblock]$CommandRunner,$Policy=(Get-DshOfficialDesktopBuildPolicy),[string]$Registry='https://registry.npmjs.org/')
 $check=Get-DshOfficialDesktopBuildCheck $BuildRoot $CommandRunner $Policy $Registry;if($Action-eq'Check'-or$check.status-ne'ready'){return $check};$root=$check.buildRoot;$source=Join-Path $root $Policy.sourceDirectory;$commands=[Collections.Generic.List[object]]::new();if($Action-eq'Verify'){if(-not(Test-Path $source)){throw 'official-source-not-prepared'};Assert-ManagedBuildTrees $root $Policy -IncludeTarget;$envRead=@{GIT_CONFIG_NOSYSTEM='1';GIT_CONFIG_GLOBAL='NUL'};Assert-NoReparseAncestor $source;Assert-OfficialSourceState $source $check.tools.git $Policy $envRead $CommandRunner|Out-Null;Assert-OfficialManifestFacts (Get-OfficialManifestFacts $source) $Policy;$receipts=@(Get-ChildItem (Join-Path $root $Policy.receiptDirectory) -Filter 'official-desktop-*.json' -File -ErrorAction SilentlyContinue|Sort-Object LastWriteTimeUtc -Descending);if(-not$receipts.Count){throw 'verification-receipt-not-found'};$latest=$receipts[0];if(-not(Test-DshOfficialDesktopBuildReceipt $latest.FullName $source $Policy $check.tools.git $check.tools.nodeVersion $Policy.packageManager.Split('@')[-1] $CommandRunner)){throw 'command-order'};return [pscustomobject]@{action='verify';status='verified';sourceRoot=$source;receiptPath=$latest.FullName}}
 Initialize-OfficialBuildRoot $root $Policy;$environment=New-IsolatedEnvironment $root;if($Action-eq'Prepare'){if(Test-Path $source){throw 'prepare-refuses-existing-source'};$clone=Invoke-OfficialGit clone-official-tag $check.tools.git @('clone','--no-checkout','--filter=blob:none',$Policy.repository,$source) $root $environment $CommandRunner;$fetch=Invoke-OfficialGit fetch-official-tag $check.tools.git @('fetch','--no-tags','origin',('refs/tags/'+$Policy.tag+':refs/tags/'+$Policy.tag)) $source $environment $CommandRunner;$tag=(Invoke-OfficialGit resolve-fetched-tag $check.tools.git @('rev-parse',('refs/tags/'+$Policy.tag+'^{commit}')) $source $environment $CommandRunner).output[-1].Trim();if($tag-cne$Policy.commit){throw 'official-tag-commit-mismatch'};$checkout=Invoke-OfficialGit checkout-pinned-commit $check.tools.git @('checkout','--detach',$Policy.commit) $source $environment $CommandRunner}
 if(-not(Test-Path $source)){throw 'official-source-not-prepared'};Assert-ManagedBuildTrees $root $Policy -IncludeTarget;$state=Assert-OfficialSourceState $source $check.tools.git $Policy $environment $CommandRunner;Assert-OfficialManifestFacts (Get-OfficialManifestFacts $source) $Policy;$initialLock=$state.lockHash;$pnpmVersion=$Policy.packageManager.Split('@')[-1];$pnpm=Invoke-OfficialCheckedCommand pnpm-version $check.tools.corepack @(('pnpm@'+$pnpmVersion),'--version') $source $environment $CommandRunner;$commands.Add($pnpm.record);$actual=$pnpm.output[-1].Trim();if($actual-cne$pnpmVersion){throw 'pnpm-version-mismatch'};$install=Invoke-OfficialCheckedCommand frozen-install $check.tools.corepack (@(('pnpm@'+$pnpmVersion))+@($Policy.officialCommands.install)) $source $environment $CommandRunner;$commands.Add($install.record);Assert-OfficialSourceState $source $check.tools.git $Policy $environment $CommandRunner $initialLock|Out-Null;$routing=$null;$local=$null
 if($Action-cin@('Build','PackageLocal')){$routing=Invoke-PreparedDesktopBuild $source $root $Policy $check $environment $CommandRunner $check.registry $commands $initialLock}
 if($Action-eq'PackageLocal'){$target=Join-Path $source ($script:ArtifactRelativeRoot.Replace('/','\'));Assert-NoReparseAncestor $target;$artifacts=Join-Path $target 'artifacts';if(Test-Path $artifacts){Assert-NoReparseTree $artifacts;Remove-Item $artifacts -Recurse -Force};$overlay=New-LocalOverlay $root $source $Policy;$packageEnv=@{};foreach($key in $environment.Keys){$packageEnv[$key]=$environment[$key]};foreach($name in @('DSH_DESKTOP_TARGET','DSH_DESKTOP_TARGET_PLATFORM','DSH_DESKTOP_TARGET_ARCH','DSH_DESKTOP_WINDOWS_CER_FILE','DSH_DESKTOP_WINDOWS_SIGNTOOL','DSH_DESKTOP_WINDOWS_TOKEN_PIN','DSH_DESKTOP_WINDOWS_KEY_CONTAINER','WIN_CSC_LINK','WIN_CSC_KEY_PASSWORD','CSC_LINK','CSC_KEY_PASSWORD')){$packageEnv[$name]=$null};$packageEnv.DSH_DESKTOP_APP_ID=$Policy.localPackage.appId;$packageEnv.DSH_DESKTOP_AUTO_UPDATE_ENV='test';$packageEnv.DOWNLOAD_TEST_ORIGIN=$Policy.localPackage.testOrigin;$packageArgs=@(('pnpm@'+$pnpmVersion),'exec','electron-builder','--config',$overlay.path,'--win','--x64','--publish','never');$desktopRoot=Join-Path $source 'apps\desktop';Assert-NoReparseAncestor $desktopRoot;$package=Invoke-OfficialCheckedCommand local-electron-builder $check.tools.corepack $packageArgs $desktopRoot $packageEnv $CommandRunner;$commands.Add($package.record);Assert-OfficialSourceState $source $check.tools.git $Policy $environment $CommandRunner $initialLock|Out-Null;$local=Get-LocalPackageEvidence $source $root $Policy $overlay.path}
 $final=Assert-OfficialSourceState $source $check.tools.git $Policy $environment $CommandRunner $initialLock;$receipt=[pscustomobject][ordered]@{schemaVersion=1;action=$Action.ToLowerInvariant();status='complete';createdUtc=[DateTime]::UtcNow.ToString('o');source=[pscustomobject]@{repository=$Policy.repository;tag=$Policy.tag;commit=$final.identity.commit;tree=$final.identity.tree;clean=$final.identity.clean;lockfileSha256=$final.lockHash};tools=[pscustomobject]@{nodeVersion=$check.tools.nodeVersion;packageManager=$Policy.packageManager;pnpmVersion=$actual};commands=@($commands.ToArray());artifacts=@(Get-OfficialArtifactInventory $source);validation=[pscustomobject]@{launchedGui=$false;installedDesktop=$false;trackedSourceModified=(-not$final.identity.clean);isolatedDshHome=$environment.DSH_HOME};releaseBoundary=$(if($Action-eq'PackageLocal'){$Policy.localReleaseBoundary}else{$Policy.releaseBoundary})};if($routing){$receipt|Add-Member registryRouting $routing};if($local){$receipt|Add-Member localPackage $local};$receiptName="official-desktop-$($Action.ToLowerInvariant())-$([DateTime]::UtcNow.ToString('yyyyMMddTHHmmssfffffffZ')).json";$receiptPath=Join-Path (Join-Path $root $Policy.receiptDirectory) $receiptName;$written=Write-DshOfficialDesktopBuildReceipt $receipt $receiptPath;if(-not(Test-DshOfficialDesktopBuildReceipt $receiptPath $source $Policy $check.tools.git $check.tools.nodeVersion $pnpmVersion $CommandRunner)){throw("receipt-self-verification-failed:"+$script:LastReceiptValidationError)};[pscustomobject]@{action=$Action.ToLowerInvariant();status='complete';sourceRoot=$source;receiptPath=$receiptPath;receipt=$written}
}
