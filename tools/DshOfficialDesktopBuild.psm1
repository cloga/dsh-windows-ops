    if($BuildRoot.StartsWith('\\')-or$BuildRoot.StartsWith('//')){throw 'build-root-must-be-fixed-local-drive'}
    $root=Get-NormalizedPath $BuildRoot;$driveName=[IO.Path]::GetPathRoot($root).TrimEnd('\').TrimEnd(':');$drive=Get-PSDrive -Name $driveName -PSProvider FileSystem -ErrorAction SilentlyContinue
    if(-not$drive-or$drive.DisplayRoot-or($drive.Root-and$drive.Root.StartsWith('\\'))){throw 'build-root-must-be-fixed-local-drive'}
    try{if([IO.DriveInfo]::new([IO.Path]::GetPathRoot($root)).DriveType-ne[IO.DriveType]::Fixed){throw 'build-root-must-be-fixed-local-drive'}}catch{if($_.Exception.Message-eq'build-root-must-be-fixed-local-drive'){throw};throw 'build-root-must-be-fixed-local-drive'}
    if((Test-PathAtOrWithin $root $RepositoryRoot)-or(Test-PathAtOrWithin $RepositoryRoot $root)){throw 'build-root-must-not-contain-or-be-inside-operations-repository'}
    foreach($cloud in @($env:OneDrive,$env:OneDriveCommercial,$env:OneDriveConsumer,$env:Dropbox,$env:GoogleDrive)){if($cloud-and[IO.Path]::IsPathRooted($cloud)-and(Test-PathAtOrWithin $root $cloud)){throw 'build-root-cloud-synchronized'}}
    if($root-match'(?i)(^|[\\/])(OneDrive(?: - [^\\/]+)?|Dropbox|Google Drive|iCloudDrive)([\\/]|$)'){throw 'build-root-cloud-synchronized'}
    Assert-NoReparseAncestor $root;foreach($child in @('source','tool-state','receipts')){Assert-NoReparseAncestor (Join-Path $root $child)};$root
}
