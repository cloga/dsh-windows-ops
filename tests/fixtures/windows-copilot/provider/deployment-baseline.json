{
  "schemaVersion": 1,
  "baseline": {
    "id": "cloga.dsh-github-copilot",
    "kind": "fork-deployment-baseline",
    "source": "https://github.com/cloga/dsh-github-copilot",
    "sourceCommitPolicy": "exact-external-pin"
  },
  "package": {
    "name": "dsh-github-copilot",
    "version": "0.3.0-cloga.1"
  },
  "supportedBaselines": {
    "platforms": [
      "windows"
    ],
    "node": ">=22.0.0",
    "dsh": {
      "release": "0.1.1-rc.2",
      "developmentRelease": "0.1.2-alpha.3",
      "peerRange": "^0.1.1-rc.2 || ^0.1.2-alpha.2"
    },
    "copilot": {
      "apis": ["openai-responses", "openai-completions"],
      "modelCatalogEndpoint": "/v1/models",
      "metadataProfile": "optional-copilot-model-capabilities",
      "mainAgent": true,
      "acpSubagents": false
    }
  },
  "capabilities": [
    {
      "id": "responses-replay-item-id-normalization",
      "required": true
    },
    {
      "id": "grounded-sandbox-escalation",
      "required": true
    },
    {
      "id": "official-vision-route-bypass",
      "required": true
    },
    {
      "id": "github-copilot-model-catalog",
      "required": true
    },
    {
      "id": "github-copilot-route-composition",
      "required": true
    },
    {
      "id": "dsh-runtime-compatibility-guard",
      "required": true
    },
    {
      "id": "orphaned-replay-item-filtering",
      "required": true
    },
    {
      "id": "traditional-search-compatibility-bridge",
      "required": true
    },
    {
      "id": "nonempty-reasoning-blocks",
      "required": true
    },
    {
      "id": "settings-provider-instance-api",
      "required": true
    }
  ]
}
