    foreach($name in @('NODE_OPTIONS','NODE_PATH','npm_config_script_shell','GIT_DIR','GIT_WORK_TREE','GIT_INDEX_FILE','GIT_OBJECT_DIRECTORY','GIT_ALTERNATE_OBJECT_DIRECTORIES','GIT_CEILING_DIRECTORIES','GIT_CONFIG_COUNT','GIT_SSH','GIT_SSH_COMMAND','SSH_ASKPASS','GIT_ASKPASS','COREPACK_INTEGRITY_KEYS')){$safe[$name]=$null}
