          ["--dir", "native/landlock-run/packages/entry", "pack", "--pack-destination", "{sourceRoot}\\dist\\npm-landlock"]
        ]
      },
      "install": {
        "script": "release:install-local",
        "attestedFiles": [
          {
            "role": "root-shim",
            "path": "dsh.cmd"
          },
          {
            "role": "npm-shim",
            "path": "node_modules\\.bin\\dsh.cmd"
          },
          {
            "role": "entrypoint",
            "path": "node_modules\\@deepseek-ai\\dsh\\lib\\bin.js"
          }
        ]
      }
    },
    "gateway": {
      "version": "0.6.1",
      "source": {
