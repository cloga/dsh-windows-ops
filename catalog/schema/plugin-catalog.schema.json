{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloga/dsh-windows-ops/catalog/schema/plugin-catalog.schema.json",
  "title": "DSH Windows Ops plugin catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updatedAt",
    "validationLevels",
    "suites",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "validationLevels": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4",
              "L5",
              "baseline"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "profile",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "plugin",
                "requiredByBaseDeployment"
              ],
              "properties": {
                "plugin": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "requiredByBaseDeployment": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "categories",
        "integration",
        "source",
        "platforms",
        "recommendation",
        "validation",
        "security",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "computer-use",
              "browser-automation",
              "desktop-automation",
              "vision",
              "search",
              "model-provider",
              "subagent",
              "operations",
              "recovery",
              "testing",
              "scheduling",
              "automation"
            ]
          }
        },
        "integration": {
          "enum": [
            "cordis",
            "mcp",
            "browser-extension",
            "external-service",
            "mixed"
          ]
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "url",
            "sha256"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://github\\.com/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "releaseTag": {
              "type": "string",
              "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z]+(\\.[0-9A-Za-z]+)*)?$"
            },
            "releaseCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "releaseImmutable": {
              "type": "boolean"
            },
            "checksumManifestUrl": {
              "type": "string",
              "pattern": "^https://github\\.com/"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "checksumManifestSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "checksumManifestSize": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^https://github\\.com/"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "reviewedHead": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "mergeCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "pullRequest": {
              "type": "integer",
              "minimum": 1
            },
            "release": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "macos",
              "linux",
              "cross-platform"
            ]
          }
        },
        "recommendation": {
          "enum": [
            "recommended",
            "conditional",
            "experimental",
            "historical",
            "rejected",
            "unreviewed"
          ]
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "verifiedAt",
            "evidence"
          ],
          "properties": {
            "level": {
              "enum": [
                "L0",
                "L1",
                "L2",
                "L3",
                "L4",
                "L5",
                "baseline"
              ]
            },
            "verifiedAt": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "dshVersion": {
              "type": [
                "string",
                "null"
              ]
            },
            "nodeVersion": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "description"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "discovery",
                      "source-review",
                      "compat-check",
                      "import-probe",
                      "composition-mount",
                      "functional-smoke",
                      "deployment-lock",
                      "upstream-change"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "controlsDesktop",
            "capturesScreen",
            "usesExistingBrowserProfile",
            "sendsDataExternally",
            "approvalGate",
            "notes"
          ],
          "properties": {
            "controlsDesktop": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "capturesScreen": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "usesExistingBrowserProfile": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "sendsDataExternally": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "approvalGate": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
